# URL базы данных. Для SQLite — путь относительно корня проекта.
DATABASE_URL=sqlite:///data/p2p.db

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Интервал основного снапшота трекера (секунды). Рекомендуется: 30–120.
TRACKER_INTERVAL_SECONDS=60

# Интервал глубокого снапшота — дополнительные страницы ордеров (секунды). Рекомендуется: 600–1800.
DEEP_SNAPSHOT_INTERVAL_SECONDS=900

# Корректная работа кириллицы в Windows-консоли
PYTHONUTF8=1

# API-ключ для защиты write-эндпоинтов (POST /api/trades, DELETE /api/trades/{id}).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-api-key-here

# Разрешённые CORS-origins через запятую (без пробелов).
CORS_ORIGINS=http://localhost:5173

# Anthropic AI-агент. Ключ получить на console.anthropic.com.
# Модель: claude-haiku-4-5 (быстрый/дешёвый), claude-sonnet-4-6 (умнее).
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-haiku-4-5
